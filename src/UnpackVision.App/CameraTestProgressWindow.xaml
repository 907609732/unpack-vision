<Window x:Class="UnpackVision.App.CameraTestProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="机位测试" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F5F7FA" ShowInTaskbar="False">
  <Border Margin="18" Padding="24" Background="White" BorderBrush="#18000000"
          BorderThickness="1" CornerRadius="20">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="56" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="StatusIconBorder" Width="48" Height="48" CornerRadius="15"
                Background="#EAF3FF" VerticalAlignment="Top">
          <TextBlock x:Name="StatusIconText" Text="&#xE9D9;" FontFamily="Segoe Fluent Icons"
                     FontSize="22" Foreground="#1677FF"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="10,1,0,0">
          <TextBlock x:Name="TitleText" Text="正在测试摄像头"
                     FontSize="20" FontWeight="SemiBold" Foreground="#1D1D1F" />
          <TextBlock Text="测试约需15秒，请保持摄像头连接，不要关闭设备。"
                     Foreground="#6E7279" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
      </Grid>

      <Border Background="#F5F8FC" BorderBrush="#16000000" BorderThickness="1"
              CornerRadius="14" Padding="16" Margin="0,20,0,0">
        <StackPanel>
          <Grid>
            <TextBlock x:Name="StageText" Text="正在准备测试"
                       FontWeight="SemiBold" Foreground="#2B3340" />
            <TextBlock x:Name="PercentText" Text="0%" HorizontalAlignment="Right"
                       FontWeight="SemiBold" Foreground="#1677FF" />
          </Grid>
          <ProgressBar x:Name="TestProgressBar" Minimum="0" Maximum="100" Value="0"
                       Height="9" Margin="0,12,0,0" />
          <TextBlock x:Name="RemainingText" Text="正在连接设备，请稍候…"
                     Foreground="#727780" FontSize="12.5" TextWrapping="Wrap" Margin="0,9,0,0" />
        </StackPanel>
      </Border>

      <TextBlock x:Name="ResultText" Visibility="Collapsed" TextWrapping="Wrap"
                 Foreground="#4E535B" FontSize="12.5" Margin="0,14,0,0" />
      <Button x:Name="CloseButton" Content="完成" Width="96" HorizontalAlignment="Right"
              Margin="0,20,0,0" Visibility="Collapsed" IsDefault="True"
              Click="CloseButton_OnClick" />
    </StackPanel>
  </Border>
</Window>
