<Window x:Class="UnpackVision.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UnpackVision.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="拆包智录" Width="1480" Height="920"
        MinWidth="1180" MinHeight="740" Background="#F3F5F8"
        WindowStartupLocation="CenterScreen" KeyDown="Window_OnKeyDown"
        WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="74" ResizeBorderThickness="7" CornerRadius="16"
                        GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="MicroLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Height" Value="56" />
      <Setter Property="MinWidth" Value="92" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Storyboard x:Key="WindowEntrance">
      <DoubleAnimation Storyboard.TargetName="MainShell" Storyboard.TargetProperty="Opacity"
                       From="0" To="1" Duration="0:0:0.24" />
      <DoubleAnimation Storyboard.TargetName="MainShell"
                       Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                       From="8" To="0" Duration="0:0:0.28">
        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
  </Window.Resources>
  <Window.Triggers>
    <EventTrigger RoutedEvent="Window.Loaded">
      <BeginStoryboard Storyboard="{StaticResource WindowEntrance}" />
    </EventTrigger>
  </Window.Triggers>

  <Grid x:Name="MainShell" Margin="22,16,22,12" Opacity="0">
    <Grid.RenderTransform><TranslateTransform Y="8" /></Grid.RenderTransform>
    <Grid.RowDefinitions>
      <RowDefinition x:Name="HeaderRow" Height="74" />
      <RowDefinition x:Name="CameraToolbarRow" Height="56" />
      <RowDefinition Height="*" />
      <RowDefinition x:Name="FooterRow" Height="34" />
    </Grid.RowDefinitions>

    <Border x:Name="UpdateBanner" Grid.Row="2" Panel.ZIndex="50"
            VerticalAlignment="Top" Margin="28,16,28,0" Padding="16,12"
            Background="#F2EAF5FF" BorderBrush="#663478F6" BorderThickness="1"
            CornerRadius="16" Visibility="Collapsed" Effect="{StaticResource FloatingShadow}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="UpdateBannerIcon" Text="&#xE895;" FontFamily="Segoe Fluent Icons"
                   FontSize="18" Foreground="#3478F6" VerticalAlignment="Center" Margin="0,0,12,0" />
        <StackPanel Grid.Column="1">
          <TextBlock x:Name="UpdateBannerTitle" Text="发现新版本" FontWeight="SemiBold" />
          <TextBlock x:Name="UpdateBannerMessage" Foreground="#5E6573" Margin="0,3,0,0"
                     TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Button Content="更新说明" Style="{StaticResource SecondaryButton}" Padding="12,6"
                  Click="UpdateNotesButton_OnClick" />
          <Button x:Name="UpdateInstallButton" Content="重启并安装" Padding="13,6" Margin="8,0,0,0"
                  Click="UpdateInstallButton_OnClick" />
          <Button Content="稍后" Style="{StaticResource ToolbarButton}" Padding="10,6" Margin="4,0,0,0"
                  Click="UpdateDismissButton_OnClick" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Header: same navigation, quieter hierarchy. -->
    <Border x:Name="TopHeader" Grid.Row="0" Background="#F9FFFFFF" BorderBrush="#1C000000"
            BorderThickness="1" CornerRadius="22,22,0,0">
      <Grid Margin="20,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="{StaticResource AppBrandLogo}"
                 Width="48" Height="48" Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="拆包智录" FontSize="21" FontWeight="SemiBold" Foreground="#1D1D1F" />
            <TextBlock Text="拆包录像与数据同步" FontSize="11.5" Foreground="#7C7C82" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#EEF1F5" CornerRadius="14" Padding="3"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="RecordingPageButton" Content="拆包录像" Style="{StaticResource SecondaryButton}"
                    Padding="18,8" Click="RecordingPageButton_OnClick" />
            <Button x:Name="BarcodePageButton" Content="条码设计" Style="{StaticResource SecondaryButton}"
                    Padding="18,8" Margin="3,0,0,0" Click="BarcodePageButton_OnClick" />
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource ToolbarButton}" Click="SettingsButton_OnClick"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="15" VerticalAlignment="Center" />
              <TextBlock Text="系统设置" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Button Style="{StaticResource ToolbarButton}" Width="36" Padding="0" Content="&#xE921;"
                  FontFamily="Segoe Fluent Icons" ToolTip="最小化" Click="MinimizeButton_OnClick"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
          <Button Style="{StaticResource ToolbarButton}" Width="36" Padding="0" Content="&#xE922;"
                  FontFamily="Segoe Fluent Icons" ToolTip="最大化" Click="MaximizeButton_OnClick"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
          <Button Style="{StaticResource ToolbarButton}" Width="36" Padding="0" Content="&#xE8BB;"
                  FontFamily="Segoe Fluent Icons" ToolTip="关闭" Click="CloseButton_OnClick"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Camera source stays top-left. -->
    <Border x:Name="CameraToolbar" Grid.Row="1" Background="#F9FFFFFF" BorderBrush="#1C000000"
            BorderThickness="1,0,1,1" CornerRadius="0,0,22,22">
      <Grid Margin="18,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#FCFCFD" BorderBrush="#23000000" BorderThickness="1" CornerRadius="13" Padding="2">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE722;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="10,0,4,0" VerticalAlignment="Center" />
              <ComboBox x:Name="CameraSourceSelector" Width="196" Height="36" Padding="5,4" BorderThickness="0"
                        Background="Transparent" SelectionChanged="CameraSourceSelector_OnSelectionChanged"
                        ToolTip="录像空闲时可快速切换摄像头来源" />
            </StackPanel>
          </Border>
          <Ellipse Width="8" Height="8" Fill="#34C759" Margin="15,0,8,0" />
          <TextBlock x:Name="CameraNameText" Text="正在探测设备" Foreground="#4F4F54" VerticalAlignment="Center" />
          <TextBlock Text=" · " Foreground="#A0A0A5" Margin="7,0" VerticalAlignment="Center" />
          <TextBlock x:Name="ResolutionText" Text="3840 × 2160" Foreground="#7C7C82" VerticalAlignment="Center" />
          <TextBlock Text=" · " Foreground="#A0A0A5" Margin="7,0" VerticalAlignment="Center" />
          <TextBlock x:Name="FpsText" Text="15 fps" Foreground="#7C7C82" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ImageAdjustButton" Style="{StaticResource ToolbarButton}" Click="ImageAdjustButton_OnClick">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9E9;" FontFamily="Segoe Fluent Icons" /><TextBlock Text="画面" Margin="7,0,0,0" /></StackPanel>
          </Button>
          <Button x:Name="AutoFocusButton" Style="{StaticResource ToolbarButton}" Content="自动聚焦：开" Margin="4,0,0,0" Click="AutoFocusButton_OnClick" />
          <Button Style="{StaticResource ToolbarButton}" Margin="4,0,0,0" Click="FocusOnceButton_OnClick">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B9;" FontFamily="Segoe Fluent Icons" /><TextBlock Text="一键聚焦" Margin="7,0,0,0" /></StackPanel>
          </Button>
          <Border x:Name="CameraStatusBadge" Background="#E8F8EF" CornerRadius="12" Padding="10,5" Margin="8,0,0,0">
            <TextBlock x:Name="CameraStatusText" Text="正在连接相机…" Foreground="#207E4E" FontSize="11" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="RecordingWorkspace" Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="PreviewColumn" Width="2.35*" />
        <ColumnDefinition x:Name="ResultsColumn" Width="1*" MinWidth="390" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition x:Name="BottomControlsRow" Height="196" />
        </Grid.RowDefinitions>

        <Border x:Name="PreviewBorder" Background="#121418" CornerRadius="22" ClipToBounds="True" Effect="{StaticResource PanelShadow}">
          <Grid>
            <Image x:Name="CameraPreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" />
            <StackPanel x:Name="CameraPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="&#xE722;" FontFamily="Segoe Fluent Icons" FontSize="40" Foreground="#50545C" HorizontalAlignment="Center" />
              <TextBlock Text="正在连接实时相机…" Foreground="#D0D2D7" FontSize="16" Margin="0,12,0,0" HorizontalAlignment="Center" />
              <TextBlock Text="如果 HIK SCAN 正在运行，请先关闭旧软件释放摄像头" Foreground="#7F858F" Margin="0,7,0,0" />
            </StackPanel>

            <StackPanel x:Name="WatermarkPreview" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" Visibility="Collapsed">
              <TextBlock x:Name="WatermarkTimeText" Foreground="White" FontSize="15" FontWeight="SemiBold">
                <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" /></TextBlock.Effect>
              </TextBlock>
              <TextBlock x:Name="WatermarkTrackingText" Foreground="White" FontSize="15" FontWeight="SemiBold">
                <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" /></TextBlock.Effect>
              </TextBlock>
              <TextBlock x:Name="WatermarkIssueText" Foreground="#FF6666" FontSize="14" FontWeight="SemiBold"
                         TextWrapping="Wrap" MaxWidth="520">
                <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" /></TextBlock.Effect>
              </TextBlock>
            </StackPanel>

            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="18" Background="#B42B2E33"
                    BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="16" Padding="13,7">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="#34C759" Margin="0,0,8,0" />
                <TextBlock Text="实时预览" Foreground="White" FontSize="11" />
                <TextBlock Text=" · " Foreground="#BFFFFFFF" Margin="5,0" />
                <TextBlock Text="{Binding Text, ElementName=ResolutionText}" Foreground="White" FontSize="11" />
              </StackPanel>
            </Border>

            <Border x:Name="RecordingBadge" Background="#F04D4D" CornerRadius="16" Padding="13,7"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,58,0,0" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="White" Margin="0,0,7,0" />
                <TextBlock x:Name="RecordingTimeText" Text="录制中 00:00:00" Foreground="White" FontWeight="SemiBold" />
              </StackPanel>
            </Border>

            <Border x:Name="PreviewTools" Background="#B82C2E32" BorderBrush="#42FFFFFF" BorderThickness="1"
                    CornerRadius="20" Padding="6" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,18" Effect="{StaticResource FloatingShadow}">
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource GlassButton}" BorderThickness="0" Click="SnapshotButton_OnClick" Content="拍照" />
                <Button Style="{StaticResource GlassButton}" BorderThickness="0" Click="RotateLeftButton_OnClick" Content="左转" />
                <Button Style="{StaticResource GlassButton}" BorderThickness="0" Click="RotateRightButton_OnClick" Content="右转" />
                <Button Style="{StaticResource GlassButton}" BorderThickness="0" Click="MirrorButton_OnClick" Content="镜像" />
                <Button Style="{StaticResource GlassButton}" BorderThickness="0" Click="FullScreenButton_OnClick" Content="全屏" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <!-- Original workflow strip, visually condensed. -->
        <Border x:Name="BottomControlPanel" Grid.Row="1" Margin="0,14,0,0" Background="#F9FFFFFF"
                BorderBrush="#1F000000" BorderThickness="1" CornerRadius="22" Padding="16"
                Effect="{StaticResource PanelShadow}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="202" />
              <ColumnDefinition Width="220" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#EEF1F5" CornerRadius="17" Padding="4" VerticalAlignment="Center">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Button x:Name="UnpackingModeButton" Style="{StaticResource ModeButton}" Content="拆包" Click="UnpackingModeButton_OnClick" />
                <Button x:Name="PackingModeButton" Grid.Column="1" Style="{StaticResource ModeButton}" Content="打包" Click="PackingModeButton_OnClick" />
              </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="FaceZoomButton" Style="{StaticResource SecondaryButton}" Content="面单放大：关" Padding="10,7" Click="FaceZoomButton_OnClick" />
                <Button x:Name="VoiceButton" Style="{StaticResource IconCircleButton}" Content="&#xE767;" Margin="7,0,0,0"
                        ToolTip="语音播报" Click="VoiceButton_OnClick" />
                <Button Style="{StaticResource IconCircleButton}" Content="&#xE713;" Margin="7,0,0,0"
                        ToolTip="单号配置" Click="SettingsButton_OnClick" />
              </StackPanel>
              <TextBox x:Name="OutputPathText" Grid.Row="1" Style="{StaticResource SelectableText}" Margin="3,7,0,0"
                       Foreground="#79797E" FontSize="11" ToolTip="录像输出位置" MaxWidth="208" />
            </Grid>

            <Border Grid.Column="2" Background="#F7FAFE" BorderBrush="#1A0A7AFF" BorderThickness="1"
                    CornerRadius="16" Padding="16,9">
              <Grid>
                <StackPanel x:Name="IdleActionPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Border Width="42" Height="42" CornerRadius="13" Background="#E7F2FF">
                    <TextBlock Text="&#xE8B0;" FontFamily="Segoe Fluent Icons" FontSize="21" Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Margin="14,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="扫描快递单号开始录制" FontSize="16" FontWeight="SemiBold" Foreground="#252529" />
                    <TextBlock Text="支持扫描或手动输入单号" Style="{StaticResource MicroLabel}" Margin="0,3,0,0" />
                  </StackPanel>
                  <Border Width="32" Height="32" CornerRadius="16" Background="#0A7AFF">
                    <TextBlock Text="&#xE72A;" FontFamily="Segoe Fluent Icons" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </StackPanel>
                <Grid x:Name="RecordingActionPanel" Visibility="Collapsed" VerticalAlignment="Stretch">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <Image x:Name="CurrentTrackingBarcodeImage" Height="54" Width="190" Stretch="Fill" />
                    <TextBlock x:Name="CurrentTrackingBarcodeHintText" Text="再次扫描当前单号结束录像"
                               Foreground="#5E5E63" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                  </StackPanel>
                  <Grid Grid.Column="1" Margin="14,0,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                      <TextBlock x:Name="ActiveIssueSummaryText" Text="当前没有异常标签" Foreground="#5E5E63" VerticalAlignment="Center" />
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="撤销标签" Style="{StaticResource SecondaryButton}" Padding="10,5" Click="UndoIssueTagButton_OnClick" />
                        <Button Content="结束录像" Padding="10,5" Margin="6,0,0,0" Click="EmergencyStopButton_OnClick" />
                      </StackPanel>
                    </Grid>
                    <ItemsControl x:Name="QuickIssueTagsControl" Grid.Row="1" Margin="0,7,0,0">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Content="{Binding Name}" Tag="{Binding}" Style="{StaticResource SecondaryButton}"
                                  Padding="10,5" Margin="0,0,6,4" Click="QuickIssueTagButton_OnClick" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox x:Name="IssueNoteInput" Grid.Row="2" Margin="0,4,0,0" MinHeight="42" MaxLength="2000"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             ToolTip="输入问题细节，停止输入后自动保存" TextChanged="IssueNoteInput_OnTextChanged" />
                  </Grid>
                </Grid>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <!-- Recent recordings remain on the right. -->
      <Border x:Name="RightPanel" Grid.Column="1" Margin="14,0,0,0" Background="#F9FFFFFF"
              BorderBrush="#1F000000" BorderThickness="1" CornerRadius="22" Effect="{StaticResource PanelShadow}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="62" /><RowDefinition Height="*" /><RowDefinition Height="54" /></Grid.RowDefinitions>
          <Grid Margin="20,0">
            <TextBlock Text="最近记录" FontSize="17" FontWeight="SemiBold" Foreground="#1D1D1F" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="#34C759" />
              <TextBlock x:Name="CurrentStateText" Text="等待扫码" Foreground="#6E6E73" Margin="7,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,0">
            <ItemsControl x:Name="RecentItemsControl">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="2,5" Padding="11" Background="#FCFCFD" BorderBrush="#18000000"
                          BorderThickness="1" CornerRadius="15">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="122" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <Border Width="112" Height="78" Background="#17191D" CornerRadius="11" ClipToBounds="True">
                        <Grid>
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                          <Border Width="26" Height="26" CornerRadius="13" Background="#8C000000"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                        </Grid>
                      </Border>
                      <Grid Grid.Column="1">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                          <TextBox Text="{Binding TrackingNo, Mode=OneWay}" Style="{StaticResource SelectableText}"
                                   FontSize="14.5" FontWeight="SemiBold" Foreground="#252529" />
                          <Border Background="#FFF3DC" CornerRadius="8" Padding="6,2" Margin="6,0,0,0">
                            <TextBlock Text="重复" Foreground="#A96700" FontSize="10"
                                       Visibility="{Binding IsDuplicate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                          </Border>
                        </StackPanel>
                        <TextBox Grid.Row="1" Text="{Binding TimeText, Mode=OneWay}" Style="{StaticResource SelectableText}"
                                 Foreground="#79797E" FontSize="11" Margin="0,6,0,0" />
                        <TextBox Grid.Row="2" Text="{Binding FileSizeText, Mode=OneWay}" Style="{StaticResource SelectableText}"
                                 Foreground="#8A8A90" FontSize="11" Margin="0,3,0,0" />
                        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,6,0,0">
                          <Button Content="播放" Padding="9,4" MinHeight="26" FontSize="11" Tag="{Binding}" Click="RecentPlayButton_OnClick" />
                          <Button Content="目录" Style="{StaticResource SecondaryButton}" Padding="9,4" MinHeight="26" FontSize="11"
                                  Margin="6,0,0,0" Tag="{Binding}" Click="RecentOpenFolderButton_OnClick" />
                          <Border Background="#E9F8EF" CornerRadius="9" Padding="7,3" Margin="8,0,0,0">
                            <TextBlock Text="已同步" Foreground="#21864F" FontSize="10" />
                          </Border>
                        </StackPanel>
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Button Grid.Row="2" Style="{StaticResource ToolbarButton}" Margin="14,7" Click="HistoryButton_OnClick">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource PrimaryBrush}" />
              <TextBlock Text="查看全部记录" Margin="8,0,0,0" Foreground="#4A4A4F" />
              <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons" Margin="10,0,0,0" Foreground="#8E8E93" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Grid>

    <local:LabelDesignerView x:Name="LabelDesigner" Grid.Row="1" Grid.RowSpan="2" Margin="0,8,0,0"
                             Visibility="Collapsed" />

    <Grid Grid.Row="3" Margin="10,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse Width="8" Height="8" Fill="#34C759" />
        <TextBlock x:Name="FooterText" Text="正在初始化本地数据库与相机…" Foreground="#77777C"
                   VerticalAlignment="Center" FontSize="11" Margin="8,0,0,0" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock Text="扫码枪回退输入" Foreground="#A0A0A5" FontSize="10" VerticalAlignment="Center" />
        <TextBox x:Name="ScannerInput" Width="150" Height="24" Padding="5,1" FontSize="11" Margin="8,0,0,0"
                 KeyDown="ScannerInput_OnKeyDown" />
        <TextBox x:Name="SyncStatusText" Text="Excel：等待任务" Style="{StaticResource SelectableText}" Foreground="#8C8C91" FontSize="10"
                   VerticalAlignment="Center" Margin="12,0,0,0" />
        <TextBlock Text="版本 2.3.2 · 开发者 五成" Foreground="#A0A0A5" FontSize="10" VerticalAlignment="Center" Margin="14,0,0,0" />
      </StackPanel>
    </Grid>

    <Popup x:Name="ImageAdjustPopup" PlacementTarget="{Binding ElementName=ImageAdjustButton}" Placement="Bottom"
           StaysOpen="False" Closed="ImageAdjustPopup_OnClosed" AllowsTransparency="True">
      <Border Background="#F7FFFFFF" BorderBrush="#26000000" BorderThickness="1" CornerRadius="16"
              Padding="18" Width="300" Effect="{StaticResource FloatingShadow}" Margin="12">
        <StackPanel>
          <TextBlock Text="画面参数" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />
          <TextBlock Text="亮度" Style="{StaticResource MicroLabel}" />
          <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,3,0,0"
                  ValueChanged="ImageControlSlider_OnValueChanged" />
          <TextBlock Text="对比度" Style="{StaticResource MicroLabel}" Margin="0,11,0,0" />
          <Slider x:Name="ContrastSlider" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,3,0,0"
                  ValueChanged="ImageControlSlider_OnValueChanged" />
          <TextBlock Text="清晰度" Style="{StaticResource MicroLabel}" Margin="0,11,0,0" />
          <Slider x:Name="SharpnessSlider" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,3,0,0"
                  ValueChanged="ImageControlSlider_OnValueChanged" />
          <TextBlock Text="饱和度" Style="{StaticResource MicroLabel}" Margin="0,11,0,0" />
          <Slider x:Name="SaturationSlider" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,3,0,0"
                  ValueChanged="ImageControlSlider_OnValueChanged" />
          <TextBlock Text="滑动时实时预览，效果会同时写入录像" Style="{StaticResource MicroLabel}" Margin="0,12,0,0" />
          <Button Content="恢复默认" Style="{StaticResource SecondaryButton}" Margin="0,16,0,0" Click="RestoreImageDefaults_OnClick" />
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>
