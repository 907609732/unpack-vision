<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Settings-specific styles stay scoped to this window so a visual refresh cannot
       silently change the operational screens used during recording. -->
  <SolidColorBrush x:Key="SettingsSidebarBrush" Color="#F7F9FC" />
  <SolidColorBrush x:Key="SettingsCardBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SettingsHoverBrush" Color="#EEF4FC" />
  <SolidColorBrush x:Key="SettingsSelectedBrush" Color="#E7F2FF" />
  <SolidColorBrush x:Key="SettingsInfoBrush" Color="#EDF6FF" />

  <Style x:Key="SettingsTabControlStyle" TargetType="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel IsItemsHost="True" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid KeyboardNavigation.TabNavigation="Local">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="196" />
              <ColumnDefinition Width="18" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource SettingsSidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="18">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="18,20,18,18">
                  <Image Source="{StaticResource AppBrandLogo}" Width="44" Height="44"
                         HorizontalAlignment="Left" Stretch="Uniform"
                         RenderOptions.BitmapScalingMode="HighQuality" />
                  <TextBlock Text="系统设置" FontSize="20" FontWeight="SemiBold"
                             Margin="0,12,0,0" />
                  <TextBlock Text="管理设备与工作区" Foreground="{StaticResource TextSecondaryBrush}"
                             Margin="0,4,0,0" />
                </StackPanel>
                <ItemsPresenter Grid.Row="1" Margin="8,0,8,0" />
                <Border Grid.Row="2" Margin="14" Padding="12,10" CornerRadius="11"
                        Background="#EAF0F8">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons"
                               Foreground="#52708F" Margin="0,1,8,0" />
                    <TextBlock Text="更改会在保存后生效" FontSize="11"
                               Foreground="#52708F" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="18" ClipToBounds="True">
              <ContentPresenter ContentSource="SelectedContent"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                SnapsToDevicePixels="True" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsNavTabStyle" TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="NavChrome" Background="Transparent" CornerRadius="11"
                  Padding="12,11" BorderBrush="Transparent" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="SelectionRail" Width="4" Height="22" CornerRadius="2"
                      Background="{StaticResource PrimaryBrush}" Visibility="Collapsed" />
              <TextBlock Grid.Column="1" Text="{TemplateBinding Tag}"
                         FontFamily="Segoe Fluent Icons" FontSize="16"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <ContentPresenter Grid.Column="2" ContentSource="Header"
                                VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="NavChrome" Property="Background" Value="{StaticResource SettingsHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="NavChrome" Property="Background" Value="{StaticResource SettingsSelectedBrush}" />
              <Setter TargetName="SelectionRail" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="NavChrome" Property="BorderBrush" Value="#660A7AFF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="NavChrome" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsPageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <Style x:Key="SettingsPageDescription" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="Margin" Value="0,6,0,20" />
  </Style>

  <Style x:Key="SettingsCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SettingsCardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="Margin" Value="0,0,0,14" />
  </Style>

  <Style x:Key="SettingsCardTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <Style x:Key="SettingsCardDescription" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Margin" Value="0,5,0,16" />
  </Style>

  <Style x:Key="SettingsFieldLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="#4D5563" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="SettingsInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="11,7" />
  </Style>

  <Style x:Key="SettingsCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style x:Key="SettingsInfoPanel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SettingsInfoBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="15" />
  </Style>

  <Style x:Key="SettingsActionBar" TargetType="Border">
    <Setter Property="Background" Value="#F9FAFC" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
</ResourceDictionary>
