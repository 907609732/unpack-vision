<Window x:Class="UnpackVision.App.DeleteRecordsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="删除记录" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F5F5F7" ShowInTaskbar="False">
  <Border Margin="18" Padding="24" Background="White" BorderBrush="#18000000" BorderThickness="1" CornerRadius="20">
    <StackPanel>
      <Border Width="52" Height="52" CornerRadius="16" Background="#FFF0F0" HorizontalAlignment="Left">
        <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="23" Foreground="#D83A3A"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBlock Text="删除选中的记录？" FontSize="21" FontWeight="SemiBold" Foreground="#1D1D1F" Margin="0,17,0,0" />
      <TextBlock x:Name="DescriptionText" Foreground="#66666B" FontSize="13.5" TextWrapping="Wrap" Margin="0,8,0,0" />

      <Border Background="#F6F7FA" CornerRadius="13" Padding="15" Margin="0,20,0,0">
        <StackPanel>
          <CheckBox x:Name="DeleteFilesCheckBox" FontSize="13.5" Foreground="#2F3035"
                    Content="同时将录像和截图移到 Windows 回收站（可恢复）" />
          <TextBlock Text="未勾选时只从软件记录列表中删除，本地文件继续保留。"
                     Foreground="#838389" FontSize="11.5" Margin="24,7,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Background="#FFF8E8" CornerRadius="12" Padding="13" Margin="0,12,0,0">
        <TextBlock Text="已同步到 Excel 的行不会被删除；正在录制或保存中的记录不能删除。"
                   Foreground="#8A6210" FontSize="12" TextWrapping="Wrap" />
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
        <Button Content="取消" Width="92" IsCancel="True" Background="#EEF0F4" Foreground="#4C4C51" />
        <Button Content="删除" Width="92" Margin="10,0,0,0" IsDefault="True"
                Background="#D83A3A" Foreground="White" Click="Delete_OnClick" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
