<Window x:Class="UnpackVision.App.PairedDevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UnpackVision.App"
        Title="已配对设备" Width="940" Height="600"
        Background="#F7F8FC" WindowStartupLocation="CenterOwner">
  <Grid Margin="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid>
      <StackPanel>
        <TextBlock Text="已配对设备" FontSize="25" FontWeight="SemiBold" />
        <TextBlock Margin="0,7,0,0" Foreground="#6E7380"
                   Text="每台手机使用独立令牌。删除后，该手机将立即失去全部权限，必须重新扫码配对。" />
      </StackPanel>
      <Button x:Name="RefreshButton" Content="刷新" HorizontalAlignment="Right" VerticalAlignment="Center"
              Padding="18,8" Click="Refresh_OnClick" />
    </Grid>
    <Border Grid.Row="1" Margin="0,18,0,0" Padding="12" CornerRadius="12"
            Background="#EAF2FF" BorderBrush="#BDD5FF" BorderThickness="1">
      <TextBlock x:Name="StatusText" Text="正在读取设备…" Foreground="#235AA6" TextWrapping="Wrap" />
    </Border>
    <DataGrid x:Name="DevicesGrid" Grid.Row="2" Margin="0,16,0,0"
              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
              SelectionMode="Single" HeadersVisibility="Column">
      <DataGrid.Columns>
        <local:SelectableTextColumn Header="设备名称" Binding="{Binding Name, Mode=OneWay}" Width="150" />
        <local:SelectableTextColumn Header="状态" Binding="{Binding Status, Mode=OneWay}" Width="85" />
        <local:SelectableTextColumn Header="角色" Binding="{Binding Roles, Mode=OneWay}" Width="145" />
        <local:SelectableTextColumn Header="权限" Binding="{Binding Scopes, Mode=OneWay}" Width="220" />
        <local:SelectableTextColumn Header="配对时间" Binding="{Binding PairedAt, Mode=OneWay}" Width="145" />
        <local:SelectableTextColumn Header="最近在线" Binding="{Binding LastSeenAt, Mode=OneWay}" Width="145" />
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="3" Margin="0,16,0,0">
      <Button Content="删除选中设备" HorizontalAlignment="Left" Padding="18,9"
              Background="#FFF0F0" Foreground="#C62828" Click="Revoke_OnClick" />
      <Button Content="关闭" HorizontalAlignment="Right" Padding="24,9" IsCancel="True" />
    </Grid>
  </Grid>
</Window>
