<Window x:Class="UnpackVision.App.VideoPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1180" Height="760" MinWidth="760" MinHeight="500"
        Background="#090B10" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        KeyDown="Window_OnKeyDown">
  <Grid>
    <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                  MediaOpened="Player_OnMediaOpened" MediaEnded="Player_OnMediaEnded" />
    <Border VerticalAlignment="Top" Background="#B20A0C12" Padding="16,11">
      <Grid>
        <TextBlock x:Name="TitleText" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="—" Width="38" Padding="5" Background="Transparent" Click="Minimize_OnClick" />
          <Button Content="□" Width="38" Padding="5" Background="Transparent" Click="Maximize_OnClick" />
          <Button Content="×" Width="38" Padding="5" Background="#CCDE4242" Click="Close_OnClick" />
        </StackPanel>
      </Grid>
    </Border>
    <Border VerticalAlignment="Bottom" Background="#CC090B10" Padding="18,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="PlayPauseButton" Content="暂停" Width="72" Click="PlayPause_OnClick" />
        <Slider x:Name="ProgressSlider" Grid.Column="1" Margin="16,0" Minimum="0" Maximum="1"
                PreviewMouseDown="ProgressSlider_OnPreviewMouseDown" PreviewMouseUp="ProgressSlider_OnPreviewMouseUp" />
        <TextBlock x:Name="TimeText" Grid.Column="2" Foreground="White" VerticalAlignment="Center" Text="00:00 / 00:00" />
      </Grid>
    </Border>
  </Grid>
</Window>
