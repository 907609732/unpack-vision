<Window x:Class="UnpackVision.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史记录查询" Width="1280" Height="780" MinWidth="980" MinHeight="620"
        Background="#F7F8FC" WindowStartupLocation="CenterOwner">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="SearchInput" Height="42" Padding="14,9" FontSize="14" VerticalContentAlignment="Center"
               ToolTip="输入完整或部分快递单号" KeyDown="SearchInput_OnKeyDown" />
      <DatePicker x:Name="StartDatePicker" Grid.Column="1" Width="155" Height="42" Margin="12,0,0,0" />
      <DatePicker x:Name="EndDatePicker" Grid.Column="2" Width="155" Height="42" Margin="8,0,0,0" />
      <Button Grid.Column="3" Content="查询" Width="88" Margin="10,0,0,0" Click="Search_OnClick" />
    </Grid>

    <Grid Grid.Row="1" Margin="0,18,0,12">
      <TextBlock x:Name="ResultCountText" Text="正在加载记录…" FontSize="15" FontWeight="SemiBold" Foreground="#303543" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="重新同步" Background="#EEF0F8" Foreground="#4A5265" Click="RetrySync_OnClick" />
        <Button Content="导出录像" Margin="8,0,0,0" Background="#EEF0F8" Foreground="#4A5265" Click="ExportVideos_OnClick" />
        <Button Content="导出清单" Margin="8,0,0,0" Background="#EEF0F8" Foreground="#4A5265" Click="ExportCsv_OnClick" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8">
      <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0" CanUserAddRows="False"
                RowHeight="72" HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="录像" Width="112">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Width="96" Height="56" Background="#151821" CornerRadius="5" ClipToBounds="True">
                  <Grid>
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                    <TextBlock Text="▶" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="快递单号" Binding="{Binding TrackingNo}" Width="180" />
          <DataGridTextColumn Header="模式" Binding="{Binding Record.Workflow}" Width="85" />
          <DataGridTextColumn Header="开始时间" Binding="{Binding Record.RecordingStartedAt, StringFormat=yyyy/MM/dd HH:mm:ss}" Width="165" />
          <DataGridTextColumn Header="结束时间" Binding="{Binding Record.RecordingEndedAt, StringFormat=yyyy/MM/dd HH:mm:ss}" Width="165" />
          <DataGridTextColumn Header="时长" Binding="{Binding DurationText}" Width="75" />
          <DataGridTextColumn Header="大小" Binding="{Binding FileSizeText}" Width="80" />
          <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="135" />
          <DataGridTemplateColumn Header="操作" Width="170">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Button Content="播放" Padding="11,6" Tag="{Binding}" Click="Play_OnClick" />
                  <Button Content="目录" Padding="11,6" Margin="6,0,0,0" Background="#EEF0F8" Foreground="#4A5265"
                          Tag="{Binding}" Click="OpenFolder_OnClick" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</Window>
