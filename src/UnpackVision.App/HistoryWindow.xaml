<Window x:Class="UnpackVision.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UnpackVision.App"
        Title="全部记录" Width="1280" Height="780" MinWidth="980" MinHeight="620"
        Background="#F7F8FC" WindowStartupLocation="CenterOwner">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="SearchInput" Height="42" Padding="14,9" FontSize="14" VerticalContentAlignment="Center"
               ToolTip="搜索快递单号或备注" KeyDown="SearchInput_OnKeyDown" />
      <CheckBox x:Name="OnlyIssuesCheck" Grid.Column="1" Content="仅看异常" Margin="14,0,0,0" VerticalAlignment="Center"/>
      <ComboBox x:Name="TagFilterSelector" Grid.Column="2" Width="125" Height="42" Margin="10,0,0,0" DisplayMemberPath="Name"/>
      <DatePicker x:Name="StartDatePicker" Grid.Column="3" Width="145" Height="42" Margin="10,0,0,0" />
      <DatePicker x:Name="EndDatePicker" Grid.Column="4" Width="145" Height="42" Margin="8,0,0,0" />
      <Button Grid.Column="5" Content="查询" Width="88" Margin="10,0,0,0" Click="Search_OnClick" />
    </Grid>

    <Grid Grid.Row="1" Margin="0,18,0,12">
      <TextBlock x:Name="ResultCountText" Text="正在加载记录…" FontSize="15" FontWeight="SemiBold" Foreground="#303543" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock x:Name="SelectionCountText" Text="未选择记录" Foreground="#777B86" FontSize="12"
                   VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button x:Name="SelectAllButton" Content="全选" Background="#EEF0F8" Foreground="#4A5265"
                ToolTip="也可以按住 Ctrl 或 Shift 选择多条记录" Click="SelectAll_OnClick" />
        <Button x:Name="DeleteSelectedButton" Content="删除选中" Margin="8,0,0,0"
                Background="#FFF0F0" Foreground="#C93434" IsEnabled="False" Click="DeleteSelected_OnClick" />
        <Button Content="重新同步" Margin="8,0,0,0" Background="#EEF0F8" Foreground="#4A5265" Click="RetrySync_OnClick" />
        <Button Content="导出录像" Margin="8,0,0,0" Background="#EEF0F8" Foreground="#4A5265" Click="ExportVideos_OnClick" />
        <Button Content="导出清单" Margin="8,0,0,0" Background="#EEF0F8" Foreground="#4A5265" Click="ExportCsv_OnClick" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8">
      <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                SelectionUnit="FullRow" CanUserDeleteRows="False" SelectionChanged="HistoryGrid_OnSelectionChanged"
                PreviewKeyDown="HistoryGrid_OnPreviewKeyDown"
                GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0" CanUserAddRows="False"
                RowHeight="72" HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="录像" Width="96">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Width="82" Height="52" Background="#151821" CornerRadius="5" ClipToBounds="True">
                  <Grid>
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                    <TextBlock Text="▶" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <local:SelectableTextColumn Header="快递单号" Binding="{Binding TrackingNo}" Width="140" />
          <local:SelectableTextColumn Header="模式" Binding="{Binding Record.Workflow}" Width="62" />
          <local:SelectableTextColumn Header="开始时间" Binding="{Binding Record.RecordingStartedAt, StringFormat=yyyy/MM/dd HH:mm}" Width="130" />
          <local:SelectableTextColumn Header="结束时间" Binding="{Binding Record.RecordingEndedAt, StringFormat=yyyy/MM/dd HH:mm}" Width="130" />
          <local:SelectableTextColumn Header="时长" Binding="{Binding DurationText}" Width="60" />
          <local:SelectableTextColumn Header="大小" Binding="{Binding FileSizeText}" Width="65" />
          <local:SelectableTextColumn Header="异常标签" Binding="{Binding TagSummary}" Width="90" />
          <local:SelectableTextColumn Header="备注" Binding="{Binding NotePreview}" Width="105" />
          <local:SelectableTextColumn Header="状态" Binding="{Binding StatusText}" Width="100" />
          <DataGridTemplateColumn Header="操作" Width="205">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Button Content="播放" Padding="8,6" Tag="{Binding}" Click="Play_OnClick" />
                  <Button Content="目录" Padding="8,6" Margin="4,0,0,0" Background="#EEF0F8" Foreground="#4A5265"
                          Tag="{Binding}" Click="OpenFolder_OnClick" />
                  <Button Content="异常/备注" Padding="8,6" Margin="4,0,0,0" Background="#FFF5E8" Foreground="#9A5B00"
                          Tag="{Binding}" Click="EditAnnotation_OnClick" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</Window>
