<Window x:Class="UnpackVision.App.LegalDocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="720" Height="680" MinWidth="620" MinHeight="520"
        Background="#F4F6FA" WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="DocumentTitle" FontSize="25" FontWeight="SemiBold" />
    <Border Grid.Row="1" Margin="0,18,0,16" Padding="20" Background="White"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18">
      <TextBox x:Name="DocumentText" Style="{StaticResource SelectableText}"
               TextWrapping="Wrap" AcceptsReturn="True"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
               VerticalContentAlignment="Top" />
    </Border>
    <Button Grid.Row="2" Content="关闭" HorizontalAlignment="Right" Width="110"
            IsDefault="True" Click="Close_OnClick" />
  </Grid>
</Window>
