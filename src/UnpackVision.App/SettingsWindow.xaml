<Window x:Class="UnpackVision.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · 拆包智录"
        Width="1120" Height="760" MinWidth="960" MinHeight="680"
        Background="#F2F4F8" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles/SettingsWindowStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Keep one TabControl and the established tab order. Code-behind relies on
         SelectedIndex=1 when the camera shortcut opens this window. -->
    <TabControl x:Name="SettingsTabControl"
                Style="{StaticResource SettingsTabControlStyle}">
      <TabItem Header="存储与数据" Tag="&#xE8B7;" Style="{StaticResource SettingsNavTabStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
          <StackPanel Margin="28,26,28,14">
            <TextBlock Text="存储与数据" Style="{StaticResource SettingsPageTitle}" />
            <TextBlock Text="管理录像、Excel 工作簿以及本机恢复数据。"
                       Style="{StaticResource SettingsPageDescription}" />

            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="文件位置" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Text="录像与工作簿可以放在不同磁盘，路径会原样保留。"
                           Style="{StaticResource SettingsCardDescription}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="录像保存位置" Style="{StaticResource SettingsFieldLabel}" />
                  <TextBox x:Name="RecordingRootInput" Grid.Column="1"
                           Style="{StaticResource SettingsInput}" />
                  <Button Grid.Column="2" Content="选择" Margin="8,0,0,0"
                          Click="BrowseRecordingRoot_OnClick" />

                  <TextBlock Grid.Row="1" Text="Excel 工作簿" Margin="0,14,0,0"
                             Style="{StaticResource SettingsFieldLabel}" />
                  <TextBox x:Name="ExcelPathInput" Grid.Row="1" Grid.Column="1"
                           Margin="0,14,0,0" Style="{StaticResource SettingsInput}" />
                  <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="8,14,0,0">
                    <Button Content="选择" Click="BrowseExcel_OnClick" />
                    <Button Content="生成" Style="{StaticResource SecondaryButton}"
                            Margin="7,0,0,0" Click="CreateExcel_OnClick" />
                  </StackPanel>

                  <TextBlock Grid.Row="2" Text="工作区状态" Margin="0,16,0,0"
                             Style="{StaticResource SettingsFieldLabel}" />
                  <TextBox x:Name="WorkspaceStatusText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                           Margin="0,16,0,0" Style="{StaticResource SelectableText}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="启动与语音" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Text="控制启动后的预览行为和操作语音反馈。"
                           Style="{StaticResource SettingsCardDescription}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="最长录像" Style="{StaticResource SettingsFieldLabel}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="MaximumMinutesInput" Width="120"
                             Style="{StaticResource SettingsInput}" />
                    <TextBlock Text="分钟" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                  </StackPanel>
                  <CheckBox x:Name="LivePreviewCheck" Grid.Row="1" Grid.Column="1"
                            Content="启动后立即显示实时相机" Margin="0,16,0,0" />
                  <CheckBox x:Name="VoiceCheck" Grid.Row="2" Grid.Column="1"
                            Content="启用开始、停止和异常语音播报" Margin="0,13,0,0" />
                  <TextBlock Grid.Row="3" Text="播报音量" Margin="0,18,0,0"
                             Style="{StaticResource SettingsFieldLabel}" />
                  <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <Slider x:Name="VoiceVolumeSlider" Minimum="20" Maximum="100"
                            TickFrequency="5" Width="300" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Value, ElementName=VoiceVolumeSlider, StringFormat={}{0:0}%}"
                               Margin="12,0,0,0" Width="44" VerticalAlignment="Center" />
                    <Button Content="试听" Style="{StaticResource SecondaryButton}"
                            Margin="10,0,0,0" Click="TestVoiceButton_OnClick" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="数据检查与恢复" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Text="从录像目录检查旧数据，或在更换电脑后重建本机索引。"
                           Style="{StaticResource SettingsCardDescription}" />
                <WrapPanel>
                  <Button Content="检查旧数据" Click="CheckRecovery_OnClick" />
                  <Button Content="重建本机数据库" Style="{StaticResource SecondaryButton}"
                          Margin="8,0,0,0" Click="RecoverWorkspace_OnClick" />
                  <Button Content="查看恢复报告" Style="{StaticResource SecondaryButton}"
                          Margin="8,0,0,0" Click="OpenRecoveryReports_OnClick" />
                </WrapPanel>
                <Border Style="{StaticResource SettingsInfoPanel}" Margin="0,16,0,0">
                  <TextBlock Foreground="#245A8D" TextWrapping="Wrap" LineHeight="21"
                             Text="录像目录中的 .unpackvision 是迁移索引，请与录像一起备份。Excel 被占用时不会强行写入；任务会保留在 SQLite 队列中，工作簿关闭后自动重试。" />
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="相机信息" Tag="&#xE722;" Style="{StaticResource SettingsNavTabStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
          <StackPanel Margin="28,26,28,14">
            <TextBlock Text="相机信息" Style="{StaticResource SettingsPageTitle}" />
            <TextBlock Text="选择视频来源，并分别配置连接、录像规格与画面处理。"
                       Style="{StaticResource SettingsPageDescription}" />

            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="视频来源" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Text="录像过程中不能切换视频源；更改会在下一次启动相机时应用。"
                           Style="{StaticResource SettingsCardDescription}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="来源类型" Style="{StaticResource SettingsFieldLabel}" />
                  <ComboBox x:Name="CameraSourceKindInput" Grid.Column="1"
                            Style="{StaticResource SettingsCombo}"
                            SelectionChanged="CameraSourceKindInput_OnSelectionChanged">
                    <ComboBoxItem Content="自动选择本地摄像头" Tag="AutoLocal" />
                    <ComboBoxItem Content="指定 Windows 摄像头（USB / iVCam）" Tag="WindowsCamera" />
                    <ComboBoxItem Content="IPC / 自定义 RTSP、HTTP 视频流" Tag="NetworkStream" />
                    <ComboBoxItem Content="海康威视 NVR / DVR" Tag="HikvisionRecorder" />
                  </ComboBox>
                  <TextBlock Grid.Row="1" Text="本地摄像头" Margin="0,14,0,0"
                             Style="{StaticResource SettingsFieldLabel}" />
                  <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0">
                    <ComboBox x:Name="CameraIndexInput" Width="240"
                              Style="{StaticResource SettingsCombo}" />
                    <CheckBox x:Name="AutoBestCameraCheck"
                              Content="自动模式优先满足设定分辨率"
                              VerticalAlignment="Center" Margin="16,0,0,0" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="网络与录像机连接" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Text="只有对应的视频来源会启用这些字段；密码使用 Windows DPAPI 加密保存。"
                           Style="{StaticResource SettingsCardDescription}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="IPC 流地址" Style="{StaticResource SettingsFieldLabel}" />
                  <TextBox x:Name="NetworkStreamUrlInput" Grid.Column="1"
                           Style="{StaticResource SettingsInput}"
                           ToolTip="例如 rtsp://192.168.1.20:554/live 或 HTTP MJPEG 地址" />

                  <TextBlock Grid.Row="1" Text="海康录像机" Margin="0,14,0,0"
                             Style="{StaticResource SettingsFieldLabel}" />
                  <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,14,0,0">
                    <TextBox x:Name="HikvisionHostInput" Width="210"
                             Style="{StaticResource SettingsInput}" ToolTip="IP 地址或域名" />
                    <TextBlock Text="端口" Margin="12,0,7,0" VerticalAlignment="Center" />
                    <TextBox x:Name="HikvisionPortInput" Width="76" Style="{StaticResource SettingsInput}" />
                    <TextBlock Text="通道" Margin="12,0,7,0" VerticalAlignment="Center" />
                    <TextBox x:Name="HikvisionChannelInput" Width="66" Style="{StaticResource SettingsInput}" />
                    <ComboBox x:Name="HikvisionStreamInput" Width="96" Margin="8,0,0,0"
                              Style="{StaticResource SettingsCombo}">
                      <ComboBoxItem Content="主码流" />
                      <ComboBoxItem Content="子码流" />
                    </ComboBox>
                  </WrapPanel>

                  <TextBlock Grid.Row="2" Text="登录凭据" Margin="0,14,0,0"
                             Style="{StaticResource SettingsFieldLabel}" />
                  <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,14,0,0">
                    <TextBox x:Name="NetworkUsernameInput" Width="220"
                             Style="{StaticResource SettingsInput}" ToolTip="网络账号" />
                    <PasswordBox x:Name="NetworkPasswordInput" Width="220" Height="40"
                                 Padding="11,7" Margin="10,0,0,0" ToolTip="网络密码" />
                  </WrapPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="录像规格" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Text="分辨率与帧率应与相机能力匹配。"
                           Style="{StaticResource SettingsCardDescription}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="分辨率" Style="{StaticResource SettingsFieldLabel}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="WidthInput" Width="110" Style="{StaticResource SettingsInput}" />
                    <TextBlock Text="×" Margin="10,0" VerticalAlignment="Center" />
                    <TextBox x:Name="HeightInput" Width="110" Style="{StaticResource SettingsInput}" />
                  </StackPanel>
                  <TextBlock Grid.Row="1" Text="帧率" Margin="0,14,0,0"
                             Style="{StaticResource SettingsFieldLabel}" />
                  <TextBox x:Name="FpsInput" Grid.Row="1" Grid.Column="1" Width="120"
                           HorizontalAlignment="Left" Margin="0,14,0,0"
                           Style="{StaticResource SettingsInput}" />
                  <CheckBox x:Name="AutoFocusCheck" Grid.Row="2" Grid.Column="1"
                            Content="自动聚焦（网络视频源通常由摄像机或录像机管理）"
                            Margin="0,16,0,0" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="画面调节" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Text="软件实时处理会应用到预览和最终录像。"
                           Style="{StaticResource SettingsCardDescription}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="亮度" Style="{StaticResource SettingsFieldLabel}" />
                  <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" />
                  <TextBlock Grid.Row="1" Text="对比度" Margin="0,15,0,0" Style="{StaticResource SettingsFieldLabel}" />
                  <Slider x:Name="ContrastSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,15,0,0" />
                  <TextBlock Grid.Row="2" Text="清晰度" Margin="0,15,0,0" Style="{StaticResource SettingsFieldLabel}" />
                  <Slider x:Name="SharpnessSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,15,0,0" />
                  <TextBlock Grid.Row="3" Text="饱和度" Margin="0,15,0,0" Style="{StaticResource SettingsFieldLabel}" />
                  <Slider x:Name="SaturationSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,15,0,0" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="单号配置" Tag="&#xE8F9;" Style="{StaticResource SettingsNavTabStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
          <StackPanel Margin="28,26,28,14">
            <TextBlock Text="单号配置" Style="{StaticResource SettingsPageTitle}" />
            <TextBlock Text="设置有效单号范围、清理规则以及扫码枪防重复间隔。"
                       Style="{StaticResource SettingsPageDescription}" />

            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="识别范围" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Text="超出长度范围的内容不会作为快递单号开始录像。"
                           Style="{StaticResource SettingsCardDescription}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="单号长度" Style="{StaticResource SettingsFieldLabel}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="MinimumLengthInput" Width="100" Style="{StaticResource SettingsInput}" />
                    <TextBlock Text="—" Margin="12,0" VerticalAlignment="Center" />
                    <TextBox x:Name="MaximumLengthInput" Width="100" Style="{StaticResource SettingsInput}" />
                    <TextBlock Text="位" Margin="8,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="内容清理与防重复" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Text="需要时移除扫码枪附带的固定前后缀，并忽略短时间内的重复输入。"
                           Style="{StaticResource SettingsCardDescription}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <CheckBox x:Name="FilterPrefixCheck" Content="过滤开头" VerticalAlignment="Center" />
                  <TextBox x:Name="PrefixInput" Grid.Column="1" Style="{StaticResource SettingsInput}" />
                  <CheckBox x:Name="FilterSuffixCheck" Grid.Row="1" Content="过滤结尾"
                            VerticalAlignment="Center" Margin="0,14,0,0" />
                  <TextBox x:Name="SuffixInput" Grid.Row="1" Grid.Column="1" Margin="0,14,0,0"
                           Style="{StaticResource SettingsInput}" />
                  <TextBlock Grid.Row="2" Text="防误扫间隔（毫秒）" Margin="0,14,0,0"
                             Style="{StaticResource SettingsFieldLabel}" />
                  <TextBox x:Name="DebounceInput" Grid.Row="2" Grid.Column="1" Width="130"
                           HorizontalAlignment="Left" Margin="0,14,0,0"
                           Style="{StaticResource SettingsInput}" />
                </Grid>
                <Border Style="{StaticResource SettingsInfoPanel}" Margin="0,18,0,0">
                  <TextBlock Foreground="#245A8D" TextWrapping="Wrap" LineHeight="21"
                             Text="录制中再次扫描当前快递单号会结束并保存；扫描不同快递单号会先保存当前录像，再自动开始下一单录像。" />
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="异常标签" Tag="&#xE8EC;" Style="{StaticResource SettingsNavTabStyle}">
        <Grid Margin="28,26,28,26">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="异常标签" Style="{StaticResource SettingsPageTitle}" />
            <TextBlock Text="管理扫码快捷标签的名称、颜色和启用状态。"
                       Style="{StaticResource SettingsPageDescription}" />
          </StackPanel>
          <Border Grid.Row="1" Style="{StaticResource SettingsCard}" Margin="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="异常快捷标签" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Text="固定条码不会因标签改名或改色而改变；扫描时优先于普通快递单号。"
                           Style="{StaticResource SettingsCardDescription}" />
                <CheckBox x:Name="CaptureIssueSnapshotCheck"
                          Content="扫描异常标签时自动截取当前画面（首次默认关闭）" />
              </StackPanel>
              <DataGrid x:Name="IssueTagsGrid" Grid.Row="1" Margin="0,16,0,0"
                        AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
                <DataGrid.Columns>
                  <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="64" />
                  <DataGridTextColumn Header="名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                  <DataGridTextColumn Header="颜色" Binding="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                  <DataGridTextColumn Header="固定条码内容" Binding="{Binding BarcodeValue}" IsReadOnly="True" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
              <WrapPanel Grid.Row="2" Margin="0,14,0,0">
                <Button Content="新增标签" Click="AddIssueTag_OnClick" />
                <Button Content="删除选中" Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0" Click="DeleteIssueTag_OnClick" />
                <TextBlock Text="固定撤销条码：UV-UNDO-TAG" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="18,0,0,0" />
              </WrapPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="手机协同" Tag="&#xE8EA;" Style="{StaticResource SettingsNavTabStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
          <StackPanel Margin="28,26,28,14">
            <TextBlock Text="手机协同" Style="{StaticResource SettingsPageTitle}" />
            <TextBlock Text="将安卓手机作为扫码枪、摄像头和异常遥控器。"
                       Style="{StaticResource SettingsPageDescription}" />
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="设备配对" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Text="每台设备独立授权，可随时在电脑端永久删除。"
                           Style="{StaticResource SettingsCardDescription}" />
                <WrapPanel>
                  <Button Content="显示手机配对二维码" MinWidth="220"
                          Click="OpenDevicePairing_OnClick" />
                  <Button Content="管理已配对设备" MinWidth="190" Margin="10,0,0,0"
                          Style="{StaticResource SecondaryButton}" Click="OpenPairedDevices_OnClick" />
                </WrapPanel>
                <Border Style="{StaticResource SettingsInfoPanel}" Margin="0,18,0,0">
                  <StackPanel>
                    <TextBlock Text="连接说明" FontWeight="SemiBold" Foreground="#245A8D" />
                    <TextBlock Margin="0,6,0,0" Foreground="#245A8D" TextWrapping="Wrap" LineHeight="21"
                               Text="配对二维码五分钟有效且只能使用一次。手机访问令牌由 Android Keystore 保护，电脑端数据库只保存令牌摘要。手机和电脑必须处于同一个专用网络。" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="可用能力" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Text="手机可以扫描快递单号、控制电脑录像、添加异常标签，或直接把手机画面作为视频源。关闭“启动电脑录像”后仍可直接追加 Excel。"
                           Style="{StaticResource SettingsCardDescription}" Margin="0,7,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="关于" Tag="&#xE946;" Style="{StaticResource SettingsNavTabStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
          <StackPanel Margin="28,26,28,14">
            <TextBlock Text="关于" Style="{StaticResource SettingsPageTitle}" />
            <TextBlock Text="版本、更新、开源下载以及隐私与支持信息。"
                       Style="{StaticResource SettingsPageDescription}" />

            <Border Style="{StaticResource SettingsCard}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="{StaticResource AppBrandLogo}" Width="72" Height="72"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="拆包智录" FontSize="24" FontWeight="SemiBold" />
                  <TextBox x:Name="AboutVersionText" Text="版本 2.3.2"
                           Style="{StaticResource SelectableText}" Margin="0,7,0,0"
                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="开发者：五成" Margin="0,5,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="软件更新" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Text="更新检查只访问 GitHub，不上传单号、录像、Excel 或设备信息。"
                           Style="{StaticResource SettingsCardDescription}" />
                <CheckBox x:Name="AutoUpdateCheck" Content="自动检查并在后台下载更新" />
                <TextBox x:Name="UpdateStatusText" Style="{StaticResource SelectableText}"
                         TextWrapping="Wrap" Foreground="#5E6573" Margin="0,11,0,0" />
                <ProgressBar x:Name="UpdateProgress" Height="5" Minimum="0" Maximum="100"
                             Margin="0,10,0,0" Visibility="Collapsed" />
                <WrapPanel Margin="0,14,0,0">
                  <Button Content="立即检查更新" Click="CheckUpdate_OnClick" />
                  <Button x:Name="InstallUpdateButton" Content="重启并安装" Margin="8,0,0,0"
                          Style="{StaticResource SecondaryButton}" IsEnabled="False"
                          Click="InstallUpdate_OnClick" />
                  <Button Content="查看最新版本" Margin="8,0,0,0"
                          Style="{StaticResource SecondaryButton}" Tag="release"
                          Click="OpenProductLink_OnClick" />
                  <Button Content="下载 Windows 安装器" Margin="8,0,0,0"
                          Style="{StaticResource SecondaryButton}" Tag="windows"
                          Click="OpenProductLink_OnClick" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="开源与下载" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Text="项目源代码和安卓 companion 应用。"
                           Style="{StaticResource SettingsCardDescription}" />
                <TextBlock Text="GitHub 开源仓库" Foreground="{StaticResource TextSecondaryBrush}" />
                <DockPanel Margin="0,6,0,0">
                  <Button DockPanel.Dock="Right" Content="打开" Margin="8,0,0,0"
                          Tag="repository" Click="OpenProductLink_OnClick" />
                  <TextBox x:Name="RepositoryUrlText" Style="{StaticResource SelectableText}"
                           VerticalAlignment="Center" />
                </DockPanel>
                <Separator Margin="0,18,0,16" Background="{StaticResource BorderBrush}" />
                <DockPanel>
                  <Image x:Name="AndroidDownloadQr" DockPanel.Dock="Right" Width="112" Height="112"
                         Margin="18,0,0,0" Stretch="Uniform" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="安卓手机 APP 下载" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox x:Name="AndroidDownloadUrlText" Style="{StaticResource SelectableText}"
                             TextWrapping="Wrap" Margin="0,7,0,0" />
                    <Button Content="打开 APK 下载地址" HorizontalAlignment="Left" Margin="0,11,0,0"
                            Tag="android" Click="OpenProductLink_OnClick" />
                  </StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="隐私、安全与支持" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Text="匿名日活仅发送不可跨日关联的匿名值、平台和版本；关闭后不影响功能。"
                           Style="{StaticResource SettingsCardDescription}" />
                <CheckBox x:Name="TelemetryCheck" Content="帮助作者统计匿名日活（可随时关闭）" />
                <WrapPanel Margin="0,14,0,0">
                  <Button Content="用户协议" Style="{StaticResource SecondaryButton}"
                          Click="OpenTerms_OnClick" />
                  <Button Content="隐私政策" Style="{StaticResource SecondaryButton}"
                          Margin="8,0,0,0" Click="OpenPrivacy_OnClick" />
                  <Button Content="安全与漏洞报告" Style="{StaticResource SecondaryButton}"
                          Margin="8,0,0,0" Tag="security" Click="OpenProductLink_OnClick" />
                  <Button Content="配置专用网络防火墙" Style="{StaticResource SecondaryButton}"
                          Margin="8,0,0,0" Click="ConfigureFirewall_OnClick" />
                  <Button Content="打开日志目录" Style="{StaticResource SecondaryButton}"
                          Margin="8,0,0,0" Click="OpenLogDirectory_OnClick" />
                  <Button Content="支持作者" Margin="8,0,0,0" Click="OpenDonation_OnClick" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="使用帮助" Tag="&#xE897;" Style="{StaticResource SettingsNavTabStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
          <StackPanel Margin="28,26,28,14">
            <TextBlock Text="使用帮助" Style="{StaticResource SettingsPageTitle}" />
            <TextBlock Text="迁移、恢复和安全使用提示。"
                       Style="{StaticResource SettingsPageDescription}" />

            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="推荐迁移步骤" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Margin="0,13,0,0" TextWrapping="Wrap" FontSize="14" LineHeight="25"
                           Text="1. 保留或复制整个录像目录和 Excel。&#x0a;2. 在新电脑安装拆包智录。&#x0a;3. 选择原录像目录。&#x0a;4. 选择原 Excel。&#x0a;5. 查看恢复预览并确认合并。&#x0a;6. 重新配置摄像头并与手机扫码配对。" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsInfoPanel}" Margin="0,0,0,14">
              <TextBlock Foreground="#245A8D" TextWrapping="Wrap" LineHeight="22"
                         Text=".unpackvision 目录保存单号、时间、相对录像路径、标签、异常时间、备注和同步状态，不保存摄像头密码、手机令牌或 API 密钥。请不要只复制 MP4 而遗漏该目录。" />
            </Border>

            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="旧版目录没有便携索引怎么办？" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" Foreground="#596170" LineHeight="22"
                           Text="使用“存储与数据 → 检查旧数据”。软件会解析本软件生成的录像文件名，并读取 Excel 的隐藏同步标记；无法确定的标签和异常时间会明确标为部分恢复，不会伪造数据。" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
              <StackPanel>
                <TextBlock Text="安全说明" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" Foreground="#596170" LineHeight="22"
                           Text="匿名日活只进行出站 HTTPS 请求，不开放互联网端口，也不接收远程指令。手机协同仅允许 Windows 专用网络，禁止公共网络和路由器端口映射。" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="1" Style="{StaticResource SettingsActionBar}" Margin="214,14,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="#708096"
                     FontSize="15" VerticalAlignment="Center" />
          <TextBlock Text="修改仅在保存后生效" Foreground="{StaticResource TextSecondaryBrush}"
                     Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="取消" Style="{StaticResource SecondaryButton}"
                  MinWidth="92" Click="Cancel_OnClick" />
          <Button Content="保存设置" MinWidth="112" Margin="10,0,0,0"
                  Click="Save_OnClick" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
