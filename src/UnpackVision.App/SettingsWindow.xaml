<Window x:Class="UnpackVision.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统配置" Width="760" Height="650" MinWidth="680" MinHeight="560"
        Background="#F7F8FC" WindowStartupLocation="CenterOwner">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TabControl x:Name="SettingsTabControl" Background="White" BorderBrush="{StaticResource BorderBrush}">
      <TabItem Header="系统与同步">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid Margin="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="录像保存位置" VerticalAlignment="Center" />
            <TextBox x:Name="RecordingRootInput" Grid.Column="1" Height="38" Padding="9" />
            <Button Grid.Column="2" Content="选择" Margin="8,0,0,0" Padding="13,7" Click="BrowseRecordingRoot_OnClick" />
            <TextBlock Grid.Row="1" Text="Excel 工作簿" Margin="0,16,0,0" VerticalAlignment="Center" />
            <TextBox x:Name="ExcelPathInput" Grid.Row="1" Grid.Column="1" Height="38" Margin="0,16,0,0" Padding="9" />
            <Button Grid.Row="1" Grid.Column="2" Content="选择" Margin="8,16,0,0" Padding="13,7" Click="BrowseExcel_OnClick" />
            <TextBlock Grid.Row="2" Text="最长录像（分钟）" Margin="0,16,0,0" VerticalAlignment="Center" />
            <TextBox x:Name="MaximumMinutesInput" Grid.Row="2" Grid.Column="1" Width="130" HorizontalAlignment="Left" Height="38" Margin="0,16,0,0" Padding="9" />
            <CheckBox x:Name="LivePreviewCheck" Grid.Row="3" Grid.Column="1" Content="启动后立即显示实时相机" Margin="0,20,0,0" />
            <CheckBox x:Name="VoiceCheck" Grid.Row="4" Grid.Column="1" Content="启用开始、停止和异常语音播报" Margin="0,14,0,0" />
            <TextBlock Grid.Row="5" Text="播报音量" Margin="0,18,0,0" VerticalAlignment="Center" />
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
              <Slider x:Name="VoiceVolumeSlider" Minimum="20" Maximum="100" TickFrequency="5" Width="300" />
              <TextBlock Text="{Binding Value, ElementName=VoiceVolumeSlider, StringFormat={}{0:0}%}" Margin="12,0,0,0" VerticalAlignment="Center" />
              <Button Content="试听" Style="{StaticResource SecondaryButton}" Padding="11,5" Margin="12,0,0,0"
                      Click="TestVoiceButton_OnClick" />
            </StackPanel>
            <TextBlock Grid.Row="6" Grid.ColumnSpan="3" Margin="0,24,0,0" Foreground="#7D8494" TextWrapping="Wrap"
                       Text="Excel 被占用时不会强行写入；任务会保留在 SQLite 队列中，工作簿关闭后自动重试。" />
          </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="相机信息">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid Margin="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="视频来源" VerticalAlignment="Center" />
            <ComboBox x:Name="CameraSourceKindInput" Grid.Column="1" Height="38" Padding="8" SelectionChanged="CameraSourceKindInput_OnSelectionChanged">
              <ComboBoxItem Content="自动选择本地摄像头" Tag="AutoLocal" />
              <ComboBoxItem Content="指定 Windows 摄像头（USB / iVCam）" Tag="WindowsCamera" />
              <ComboBoxItem Content="IPC / 自定义 RTSP、HTTP 视频流" Tag="NetworkStream" />
              <ComboBoxItem Content="海康威视 NVR / DVR" Tag="HikvisionRecorder" />
            </ComboBox>

            <TextBlock Grid.Row="1" Text="本地相机序号" Margin="0,14,0,0" VerticalAlignment="Center" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0">
              <ComboBox x:Name="CameraIndexInput" Width="190" Height="38" Padding="8" />
              <CheckBox x:Name="AutoBestCameraCheck" Content="自动模式优先满足设定分辨率" VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="IPC 流地址" Margin="0,14,0,0" VerticalAlignment="Center" />
            <TextBox x:Name="NetworkStreamUrlInput" Grid.Row="2" Grid.Column="1" Height="38" Margin="0,14,0,0" Padding="9"
                     ToolTip="例如 rtsp://192.168.1.20:554/live 或 HTTP MJPEG 地址" />

            <TextBlock Grid.Row="3" Text="海康录像机" Margin="0,14,0,0" VerticalAlignment="Center" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0">
              <TextBox x:Name="HikvisionHostInput" Width="210" Height="38" Padding="9" ToolTip="IP 地址或域名" />
              <TextBlock Text=" 端口 " VerticalAlignment="Center" /><TextBox x:Name="HikvisionPortInput" Width="75" Height="38" Padding="9" />
              <TextBlock Text=" 通道 " VerticalAlignment="Center" /><TextBox x:Name="HikvisionChannelInput" Width="65" Height="38" Padding="9" />
              <ComboBox x:Name="HikvisionStreamInput" Width="90" Height="38" Margin="8,0,0,0">
                <ComboBoxItem Content="主码流" /><ComboBoxItem Content="子码流" />
              </ComboBox>
            </StackPanel>

            <TextBlock Grid.Row="4" Text="网络账号" Margin="0,14,0,0" VerticalAlignment="Center" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0">
              <TextBox x:Name="NetworkUsernameInput" Width="210" Height="38" Padding="9" />
              <TextBlock Text=" 密码 " VerticalAlignment="Center" />
              <PasswordBox x:Name="NetworkPasswordInput" Width="210" Height="38" Padding="9" />
            </StackPanel>

            <TextBlock Grid.Row="5" Text="分辨率" Margin="0,14,0,0" VerticalAlignment="Center" />
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0">
              <TextBox x:Name="WidthInput" Width="110" Height="38" Padding="9" /><TextBlock Text=" × " VerticalAlignment="Center" />
              <TextBox x:Name="HeightInput" Width="110" Height="38" Padding="9" />
            </StackPanel>
            <TextBlock Grid.Row="6" Text="帧率" Margin="0,14,0,0" VerticalAlignment="Center" /><TextBox x:Name="FpsInput" Grid.Row="6" Grid.Column="1" Width="120" HorizontalAlignment="Left" Height="38" Margin="0,14,0,0" Padding="9" />
            <CheckBox x:Name="AutoFocusCheck" Grid.Row="7" Grid.Column="1" Content="自动聚焦（网络视频源通常由摄像机或录像机管理）" Margin="0,16,0,0" />
            <TextBlock Grid.Row="8" Text="亮度" Margin="0,16,0,0" /><Slider x:Name="BrightnessSlider" Grid.Row="8" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,10,0,0" />
            <TextBlock Grid.Row="9" Text="对比度" Margin="0,16,0,0" /><Slider x:Name="ContrastSlider" Grid.Row="9" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,10,0,0" />
            <TextBlock Grid.Row="10" Text="清晰度" Margin="0,16,0,0" /><Slider x:Name="SharpnessSlider" Grid.Row="10" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,10,0,0" />
            <TextBlock Grid.Row="11" Text="饱和度" Margin="0,16,0,0" /><Slider x:Name="SaturationSlider" Grid.Row="11" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,10,0,0" />
            <TextBlock Grid.Row="12" Grid.ColumnSpan="2" Margin="0,24,0,0" Foreground="#7D8494" TextWrapping="Wrap"
                       Text="亮度、对比度、清晰度和饱和度使用软件实时处理，对 USB、iVCam、IPC 和海康录像机都有效，并会写入最终录像。网络密码使用 Windows DPAPI 加密保存。录像过程中不能切换视频源。" />
          </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="单号配置">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid Margin="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="单号长度" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <TextBox x:Name="MinimumLengthInput" Width="100" Height="38" Padding="9" /><TextBlock Text="  —  " VerticalAlignment="Center" />
              <TextBox x:Name="MaximumLengthInput" Width="100" Height="38" Padding="9" /><TextBlock Text=" 位" VerticalAlignment="Center" />
            </StackPanel>
            <CheckBox x:Name="FilterPrefixCheck" Grid.Row="1" Content="过滤开头" Margin="0,18,0,0" />
            <TextBox x:Name="PrefixInput" Grid.Row="1" Grid.Column="1" Height="38" Margin="0,12,0,0" Padding="9" />
            <CheckBox x:Name="FilterSuffixCheck" Grid.Row="2" Content="过滤结尾" Margin="0,18,0,0" />
            <TextBox x:Name="SuffixInput" Grid.Row="2" Grid.Column="1" Height="38" Margin="0,12,0,0" Padding="9" />
            <TextBlock Grid.Row="3" Text="防误扫间隔（毫秒）" Margin="0,18,0,0" VerticalAlignment="Center" />
            <TextBox x:Name="DebounceInput" Grid.Row="3" Grid.Column="1" Width="130" HorizontalAlignment="Left" Height="38" Margin="0,12,0,0" Padding="9" />
            <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Margin="0,22,0,0" Foreground="#7D8494" TextWrapping="Wrap"
                       Text="录制中再次扫描当前快递单号会结束并保存；扫描不同快递单号会先保存当前录像，再自动开始下一单录像。" />
          </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="异常标签">
        <Grid Margin="24">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="异常快捷标签" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="扫码时优先识别这些固定条码，不会被当成快递单号。标签改名或改色不会改变已经打印的条码。"
                       Foreground="#7D8494" Margin="0,6,0,0" TextWrapping="Wrap" />
            <CheckBox x:Name="CaptureIssueSnapshotCheck" Content="扫描异常标签时自动截取当前画面（首次默认关闭）" Margin="0,14,0,0" />
          </StackPanel>
          <DataGrid x:Name="IssueTagsGrid" Grid.Row="1" Margin="0,16,0,0" AutoGenerateColumns="False"
                    CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="64" />
              <DataGridTextColumn Header="名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="120" />
              <DataGridTextColumn Header="颜色" Binding="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}" Width="100" />
              <DataGridTextColumn Header="固定条码内容" Binding="{Binding BarcodeValue}" IsReadOnly="True" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="新增标签" Click="AddIssueTag_OnClick" />
            <Button Content="删除选中" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="DeleteIssueTag_OnClick" />
            <TextBlock Text="固定撤销条码：UV-UNDO-TAG" Foreground="#7D8494" VerticalAlignment="Center" Margin="18,0,0,0" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="手机协同">
        <Grid Margin="24">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <TextBlock Text="安卓手机协同" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Grid.Row="1" Margin="0,10,0,0" Foreground="#7D8494" TextWrapping="Wrap"
                     Text="手机可以充当扫码枪和摄像头；异常遥控已集成到扫码器，关闭“启动电脑录像”后可直接追加 Excel。每台设备独立授权，可随时永久删除。" />
          <StackPanel Grid.Row="2" Margin="0,24,0,0">
            <StackPanel Orientation="Horizontal">
              <Button Content="显示手机配对二维码" Width="220" Padding="16,10"
                      Click="OpenDevicePairing_OnClick" />
              <Button Content="管理已配对设备" Width="190" Margin="10,0,0,0" Padding="16,10"
                      Style="{StaticResource SecondaryButton}" Click="OpenPairedDevices_OnClick" />
            </StackPanel>
            <TextBlock Margin="0,14,0,0" Foreground="#7D8494" TextWrapping="Wrap"
                       Text="配对二维码五分钟有效且只能使用一次。手机访问令牌由 Android Keystore 保护，电脑端数据库只保存令牌摘要。" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="关于">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="32">
            <TextBlock Text="电商拆包智能录像" FontSize="30" FontWeight="SemiBold" Foreground="#202124" />
            <TextBox x:Name="AboutVersionText" Text="版本 2.2.0" Style="{StaticResource SelectableText}"
                     Margin="0,10,0,0" FontSize="15" Foreground="#6E6E73" />
            <Border Background="#F3F6FC" CornerRadius="16" Padding="20" Margin="0,24,0,0">
              <StackPanel>
                <TextBlock Text="开发者" Foreground="#7D8494" />
                <TextBox Text="五成" Style="{StaticResource SelectableText}"
                         FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" />
              </StackPanel>
            </Border>
            <TextBox Margin="0,22,0,0" TextWrapping="Wrap" Foreground="#4A5265"
                     Style="{StaticResource SelectableText}"
                     Text="面向中小商家的零成本、开源拆包录像与单号同步工具。支持手机、USB 摄像头、IPC、海康录像机、Excel 和开放接口。" />
            <TextBox Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#7D8494"
                     Style="{StaticResource SelectableText}"
                     Text="业务数据默认完全保存在本机；更新检查只访问 GitHub，不上传单号、录像、Excel 或设备信息。首次安装未签名版本时 Windows 可能显示 SmartScreen 提示。" />

            <Border Background="#F8FAFD" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="18" Margin="0,22,0,0">
              <StackPanel>
                <TextBlock Text="软件更新" FontSize="17" FontWeight="SemiBold" />
                <CheckBox x:Name="AutoUpdateCheck" Content="自动检查并在后台下载更新" Margin="0,12,0,0" />
                <TextBox x:Name="UpdateStatusText" Style="{StaticResource SelectableText}"
                         TextWrapping="Wrap" Foreground="#5E6573" Margin="0,10,0,0" />
                <ProgressBar x:Name="UpdateProgress" Height="5" Minimum="0" Maximum="100"
                             Margin="0,10,0,0" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="立即检查更新" Padding="14,7" Click="CheckUpdate_OnClick" />
                  <Button x:Name="InstallUpdateButton" Content="重启并安装" Padding="14,7" Margin="8,0,0,0"
                          Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="InstallUpdate_OnClick" />
                  <Button Content="查看最新版本" Padding="14,7" Margin="8,0,0,0"
                          Style="{StaticResource SecondaryButton}" Tag="release" Click="OpenProductLink_OnClick" />
                  <Button Content="下载 Windows 安装器" Padding="14,7" Margin="8,0,0,0"
                          Style="{StaticResource SecondaryButton}" Tag="windows" Click="OpenProductLink_OnClick" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Background="#F8FAFD" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="18" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="开源与下载" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="GitHub 开源仓库" Foreground="#7D8494" Margin="0,12,0,0" />
                <DockPanel Margin="0,5,0,0">
                  <Button DockPanel.Dock="Right" Content="打开" Padding="12,5" Margin="8,0,0,0"
                          Tag="repository" Click="OpenProductLink_OnClick" />
                  <TextBox x:Name="RepositoryUrlText" Style="{StaticResource SelectableText}" />
                </DockPanel>
                <TextBlock Text="安卓手机 APP 下载" Foreground="#7D8494" Margin="0,14,0,0" />
                <DockPanel Margin="0,5,0,0">
                  <Image x:Name="AndroidDownloadQr" DockPanel.Dock="Right" Width="112" Height="112"
                         Margin="16,0,0,0" Stretch="Uniform" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBox x:Name="AndroidDownloadUrlText" Style="{StaticResource SelectableText}"
                             TextWrapping="Wrap" />
                    <Button Content="打开 APK 下载地址" HorizontalAlignment="Left" Padding="12,6" Margin="0,10,0,0"
                            Tag="android" Click="OpenProductLink_OnClick" />
                  </StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>
            <Border Background="#F8FAFD" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="18" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="隐私、安全与支持" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0" Foreground="#7D8494" TextWrapping="Wrap"
                           Text="可随时查看本版本协议。2.2.0 不启用匿名使用统计，拒绝未来的可选统计也不会影响核心功能。" />
                <WrapPanel Margin="0,13,0,0">
                  <Button Content="用户协议" Style="{StaticResource SecondaryButton}"
                          Padding="13,6" Click="OpenTerms_OnClick" />
                  <Button Content="隐私政策" Style="{StaticResource SecondaryButton}"
                          Padding="13,6" Margin="8,0,0,0" Click="OpenPrivacy_OnClick" />
                  <Button Content="安全与漏洞报告" Style="{StaticResource SecondaryButton}"
                          Padding="13,6" Margin="8,0,0,0" Tag="security" Click="OpenProductLink_OnClick" />
                  <Button Content="配置专用网络防火墙" Style="{StaticResource SecondaryButton}"
                          Padding="13,6" Margin="8,0,0,0" Click="ConfigureFirewall_OnClick" />
                  <Button Content="支持作者" Padding="16,6" Margin="8,0,0,0"
                          Click="OpenDonation_OnClick" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <TextBox Margin="0,14,0,8" TextWrapping="Wrap" Foreground="#7D8494"
                     Style="{StaticResource SelectableText}"
                     Text="独立实现，不包含海康威视源代码、商标或专有资源。" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="取消" Background="#EEF0F8" Foreground="#4A5265" Click="Cancel_OnClick" />
      <Button Content="保存" Width="100" Margin="10,0,0,0" Click="Save_OnClick" />
    </StackPanel>
  </Grid>
</Window>
