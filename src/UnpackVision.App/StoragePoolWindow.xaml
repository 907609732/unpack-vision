<Window x:Class="UnpackVision.App.StoragePoolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="录像盘位 · 拆包智录"
        Width="940" Height="700" MinWidth="800" MinHeight="560"
        Background="#F2F4F8" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles/SettingsWindowStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="StorageToolbarButton" TargetType="Button"
             BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="0,0,8,0" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="录像盘位" Style="{StaticResource SettingsPageTitle}" />
        <TextBlock Text="按顺序使用多个硬盘；空间不足时，从下一单开始自动切换到后续可用盘位。"
                   Style="{StaticResource SettingsPageDescription}" Margin="0,6,0,12" />
      </StackPanel>
      <Image Grid.Column="1" Source="{StaticResource AppBrandLogo}" Width="52" Height="52"
             Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource SettingsCard}" Padding="14" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <WrapPanel VerticalAlignment="Center">
          <Button x:Name="AddStorageTargetButton" Content="＋ 添加录像盘"
                  Click="AddStorageTarget_OnClick" />
          <Button x:Name="MoveStorageTargetUpButton" Content="上移"
                  Style="{StaticResource StorageToolbarButton}"
                  Margin="8,0,8,0" Click="MoveStorageTargetUp_OnClick" />
          <Button x:Name="MoveStorageTargetDownButton" Content="下移"
                  Style="{StaticResource StorageToolbarButton}"
                  Click="MoveStorageTargetDown_OnClick" />
          <Button x:Name="RemoveStorageTargetButton" Content="移除盘位"
                  Style="{StaticResource StorageToolbarButton}"
                  Click="RemoveStorageTarget_OnClick" />
        </WrapPanel>
        <Button x:Name="RefreshStorageTargetsButton" Grid.Column="1" Content="检查全部"
                Style="{StaticResource SecondaryButton}" Click="RefreshStorageTargets_OnClick" />
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource SettingsCard}" Padding="10" Margin="0,0,0,12">
      <Grid>
        <ListBox x:Name="StorageTargetsList"
                 ItemsSource="{Binding Targets}"
                 SelectionChanged="StorageTargetsList_OnSelectionChanged"
                 BorderThickness="0" Background="Transparent"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,0,9" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Card" Background="#F8FAFD" BorderBrush="#18000000"
                            BorderThickness="1" CornerRadius="13" Padding="14"
                            Opacity="{Binding Opacity}">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                        <Setter TargetName="Card" Property="Background" Value="#F1F7FF" />
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Card" Property="Background" Value="#F4F8FD" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="210" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                  <TextBox Width="240" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource SettingsInput}" FontWeight="SemiBold"
                           ToolTip="可直接修改盘位名称" />
                  <Border Background="#E9F2FF" CornerRadius="9" Padding="9,5" Margin="10,5,0,5">
                    <TextBlock Text="{Binding PriorityText}" Foreground="#2468AA" FontSize="12" />
                  </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                  <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,7,0" />
                  <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                             FontWeight="SemiBold" VerticalAlignment="Center" />
                  <CheckBox Content="启用" IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                            Margin="18,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding RootPath, Mode=OneWay}"
                         Margin="0,10,0,0" IsReadOnly="True" Style="{StaticResource SelectableText}"
                         ToolTip="录像根目录（从配置移除不会删除这里的任何文件）" />

                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
                  <WrapPanel>
                    <TextBlock Text="{Binding CapacityText}" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text=" · " Foreground="#A1A8B2" />
                    <TextBlock Text="{Binding RemainingText}" Foreground="{StaticResource TextSecondaryBrush}" />
                  </WrapPanel>
                  <TextBlock Text="{Binding WarningText}" Foreground="#B56A00" Margin="0,5,0,0"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel x:Name="EmptyStoragePoolPanel" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Visibility="Collapsed">
          <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="40"
                     HorizontalAlignment="Center" Foreground="#8090A4" />
          <TextBlock Text="还没有录像盘位" FontSize="17" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Margin="0,12,0,0" />
          <TextBlock Text="点击“添加录像盘”选择一个可写目录。" Foreground="{StaticResource TextSecondaryBrush}"
                     HorizontalAlignment="Center" Margin="0,5,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource SettingsActionBar}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="移除只会删除配置，不会删除录像；同一个包裹的全部视频会保存在同一盘。"
                     Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
          <Button Content="取消" Style="{StaticResource SecondaryButton}" Width="92"
                  Click="Cancel_OnClick" />
          <Button Content="应用盘位" Width="112" Margin="10,0,0,0" Click="Save_OnClick" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
