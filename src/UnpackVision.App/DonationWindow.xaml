<Window x:Class="UnpackVision.App.DonationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="支持作者" Width="720" Height="610" MinWidth="650" MinHeight="540"
        Background="#F4F6FA" WindowStartupLocation="CenterOwner">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="支持作者 五成" FontSize="27" FontWeight="SemiBold" />
      <TextBlock Margin="0,7,0,0" Foreground="#6E6E73" TextWrapping="Wrap"
                 Text="软件永久免费开源。赞助完全自愿，不影响任何功能，也不会在软件中保存付款信息。" />
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,22,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
              CornerRadius="20" Padding="20">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="支付宝" FontSize="20" FontWeight="SemiBold" />
          <Border Width="230" Height="230" Margin="0,18,0,0" Background="#F3F5F8" CornerRadius="16">
            <Grid>
              <Image x:Name="AlipayQrImage" Margin="12" Stretch="Uniform" />
              <TextBlock x:Name="AlipayPlaceholder" Text="作者暂未配置" Foreground="#8E8E93"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="20" Padding="20">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="微信" FontSize="20" FontWeight="SemiBold" />
          <Border Width="230" Height="230" Margin="0,18,0,0" Background="#F3F5F8" CornerRadius="16">
            <Grid>
              <Image x:Name="WeChatQrImage" Margin="12" Stretch="Uniform" />
              <TextBlock x:Name="WeChatPlaceholder" Text="作者暂未配置" Foreground="#8E8E93"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </Grid>
    <StackPanel Grid.Row="2">
      <TextBlock Text="付款由支付宝或微信独立处理，本软件不读取付款人、金额、订单或付款结果。"
                 Foreground="#7D8494" TextWrapping="Wrap" HorizontalAlignment="Center" />
      <Button Content="关闭" Width="110" HorizontalAlignment="Right" Margin="0,14,0,0"
              IsDefault="True" Click="Close_OnClick" />
    </StackPanel>
  </Grid>
</Window>
