<Window x:Class="UnpackVision.App.CameraProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置机位 · 拆包智录"
        Width="820" Height="760" MinWidth="720" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#F2F4F8" ShowInTaskbar="False"
        Loaded="CameraProfileDialog_OnLoaded">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles/SettingsWindowStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="26,24,26,12">
        <Grid Margin="0,0,0,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="46" Height="46" CornerRadius="14" Background="#E8F2FF">
            <TextBlock Text="&#xE722;" FontFamily="Segoe Fluent Icons" FontSize="21"
                       Foreground="#1677FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="10,1,0,0">
            <TextBlock Text="配置机位" Style="{StaticResource SettingsPageTitle}" />
            <TextBlock Text="只显示当前来源需要填写的内容，保存后才会更新机位方案。"
                       Style="{StaticResource SettingsPageDescription}" />
          </StackPanel>
        </Grid>

        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="基本信息" Style="{StaticResource SettingsCardTitle}" />
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="机位名称" Style="{StaticResource SettingsFieldLabel}" />
              <TextBox x:Name="CameraNameInput" Grid.Column="1" MaxLength="24"
                       Style="{StaticResource SettingsInput}" />
              <TextBlock Grid.Row="1" Text="来源类型" Margin="0,14,0,0"
                         Style="{StaticResource SettingsFieldLabel}" />
              <ComboBox x:Name="CameraSourceKindInput" Grid.Row="1" Grid.Column="1" Margin="0,14,0,0"
                        Style="{StaticResource SettingsCombo}"
                        SelectionChanged="CameraSourceKindInput_OnSelectionChanged">
                <ComboBoxItem Content="自动选择本地摄像头" Tag="AutoLocal" />
                <ComboBoxItem Content="指定 Windows 摄像头（USB / iVCam）" Tag="WindowsCamera" />
                <ComboBoxItem Content="IPC / 自定义 RTSP、HTTP 视频流" Tag="NetworkStream" />
                <ComboBoxItem Content="海康威视 NVR / DVR" Tag="HikvisionRecorder" />
              </ComboBox>
            </Grid>
          </StackPanel>
        </Border>

        <Border x:Name="LocalCameraCard" Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="选择本地摄像头" Style="{StaticResource SettingsCardTitle}" />
            <TextBlock Text="列表来自 Windows 已加载的 USB、iVCam 和其他虚拟摄像头。"
                       Style="{StaticResource SettingsCardDescription}" />
            <ComboBox x:Name="CameraIndexInput" Margin="0,14,0,0"
                      Style="{StaticResource SettingsCombo}"
                      SelectionChanged="CameraIndexInput_OnSelectionChanged" />
            <CheckBox x:Name="AutoBestCameraCheck" Margin="0,12,0,0"
                      Content="自动模式优先满足设定分辨率" />
          </StackPanel>
        </Border>

        <Border x:Name="NetworkStreamCard" Style="{StaticResource SettingsCard}" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="IPC 连接" Style="{StaticResource SettingsCardTitle}" />
            <TextBlock Text="填写完整的 RTSP 或 HTTP 视频流地址；账号密码使用 Windows DPAPI 加密保存。"
                       Style="{StaticResource SettingsCardDescription}" />
            <TextBlock x:Name="IpcDiscoverySourceText"
                       Text="扫描来源：ONVIF 标准 / 兼容探测 / 海康 SADP（可用时）"
                       Style="{StaticResource SettingsCardDescription}" Margin="0,8,0,0"
                       TextWrapping="Wrap" />
            <WrapPanel Margin="0,14,0,0">
              <Button x:Name="DiscoverIpcButton" Content="扫描局域网 IPC"
                      Style="{StaticResource SecondaryButton}" Click="DiscoverIpc_OnClick" />
              <ProgressBar x:Name="IpcDiscoveryProgress" Width="110" Height="7"
                           Margin="14,0,0,0" VerticalAlignment="Center"
                           IsIndeterminate="True" Visibility="Collapsed" />
              <TextBlock x:Name="IpcDiscoveryProgressText" Text="正在扫描，约需 5–10 秒…"
                         Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#5F6672"
                         Visibility="Collapsed" />
            </WrapPanel>
            <TextBlock x:Name="IpcDiscoveryStatusText"
                       Text="扫描时不会发送账号密码；结果会标明由哪种方式发现。"
                       Style="{StaticResource SettingsCardDescription}" Margin="0,9,0,0"
                       TextWrapping="Wrap" />
            <ItemsControl x:Name="IpcDiscoveryNoticeList" Margin="0,9,0,0" Visibility="Collapsed">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="9"
                          Background="#FFF8E8" BorderBrush="#F1D79A" BorderThickness="1">
                    <TextBlock Text="{Binding}" Foreground="#805B16" FontSize="12"
                               TextWrapping="Wrap" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ListBox x:Name="IpcDiscoveryResultList" Margin="0,10,0,14" MaxHeight="210"
                     Visibility="Collapsed" SelectionChanged="IpcDiscoveryResultList_OnSelectionChanged"
                     BorderBrush="#22000000" BorderThickness="1" Background="#FAFBFD">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="8,7">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#20242A" />
                      <TextBlock Text="{Binding Details}" Margin="0,3,0,0" Foreground="#6E7279"
                                 FontSize="12" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding ValidationText}" Margin="0,3,0,0" Foreground="#98701E"
                                 FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="8,3" CornerRadius="8" Background="#E8F2FF"
                            VerticalAlignment="Center" Margin="10,0,0,0">
                      <TextBlock Text="{Binding KindText}" Foreground="#1677FF" FontSize="11" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border Margin="0,0,0,14" Padding="11,9" CornerRadius="10"
                    Background="#EEF5FF" BorderBrush="#CFE3FF" BorderThickness="1">
              <TextBlock x:Name="IpcDiscoveryVerificationNotice"
                         Text="发现成功不等于视频流已验证。请选择设备、填写凭据，并通过下方实时预览确认画面后再保存。"
                         Foreground="#245B9E" FontSize="12" TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="视频流地址" Style="{StaticResource SettingsFieldLabel}" />
            <TextBox x:Name="NetworkStreamUrlInput" Margin="0,8,0,0"
                     Style="{StaticResource SettingsInput}"
                     ToolTip="例如 rtsp://192.168.1.20:554/live" />
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="账号" Style="{StaticResource SettingsFieldLabel}" />
                <TextBox x:Name="NetworkUsernameInput" Margin="0,8,0,0" Style="{StaticResource SettingsInput}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="密码" Style="{StaticResource SettingsFieldLabel}" />
                <PasswordBox x:Name="NetworkPasswordInput" Margin="0,8,0,0" Height="40" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border x:Name="HikvisionRecorderCard" Style="{StaticResource SettingsCard}" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="海康录像机" Style="{StaticResource SettingsCardTitle}" />
            <TextBlock Text="填写录像机地址和凭据后，可自动读取真实通道。"
                       Style="{StaticResource SettingsCardDescription}" />
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="录像机地址" Style="{StaticResource SettingsFieldLabel}" />
              <TextBox x:Name="HikvisionHostInput" Grid.Column="1" Style="{StaticResource SettingsInput}"
                       ToolTip="IP 地址或域名" />
              <TextBlock Grid.Row="1" Text="端口与通道" Margin="0,14,0,0" Style="{StaticResource SettingsFieldLabel}" />
              <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,14,0,0">
                <TextBlock Text="管理" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="HikvisionHttpPortInput" Width="72" Style="{StaticResource SettingsInput}" />
                <TextBlock Text="RTSP" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox x:Name="HikvisionPortInput" Width="72" Style="{StaticResource SettingsInput}" />
                <TextBlock Text="通道" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox x:Name="HikvisionChannelInput" Width="66" Style="{StaticResource SettingsInput}" />
                <ComboBox x:Name="HikvisionStreamInput" Width="96" Margin="8,0,0,0" Style="{StaticResource SettingsCombo}">
                  <ComboBoxItem Content="主码流" />
                  <ComboBoxItem Content="子码流" />
                </ComboBox>
              </WrapPanel>
              <TextBlock Grid.Row="2" Text="登录凭据" Margin="0,14,0,0" Style="{StaticResource SettingsFieldLabel}" />
              <Grid Grid.Row="2" Grid.Column="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="HikvisionUsernameInput" Style="{StaticResource SettingsInput}" ToolTip="账号" />
                <PasswordBox x:Name="HikvisionPasswordInput" Grid.Column="2" Height="40" ToolTip="密码" />
              </Grid>
              <TextBlock Grid.Row="3" Text="通道发现" Margin="0,14,0,0" Style="{StaticResource SettingsFieldLabel}" />
              <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,14,0,0">
                <WrapPanel>
                  <Button x:Name="DiscoverHikvisionChannelsButton" Content="发现并添加全部通道"
                          Style="{StaticResource SecondaryButton}" Click="DiscoverHikvisionChannels_OnClick" />
                  <CheckBox x:Name="HikvisionPreferSubStreamCheck" Content="优先使用子码流"
                            IsChecked="True" VerticalAlignment="Center" Margin="14,0,0,0" />
                  <ProgressBar x:Name="HikvisionDiscoveryProgress" Width="100" Height="7"
                               Margin="14,0,0,0" VerticalAlignment="Center"
                               IsIndeterminate="True" Visibility="Collapsed" />
                </WrapPanel>
                <ComboBox x:Name="HikvisionDiscoveredChannelInput" Margin="0,10,0,0"
                          Style="{StaticResource SettingsCombo}" Visibility="Collapsed"
                          SelectionChanged="HikvisionDiscoveredChannelInput_OnSelectionChanged" />
                <TextBlock x:Name="HikvisionDiscoveryStatusText"
                           Text="点击后会读取录像机实际发布的通道，保存时最多补充到16个机位。"
                           Style="{StaticResource SettingsCardDescription}" Margin="0,8,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border x:Name="CameraPreviewCard" Style="{StaticResource SettingsCard}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="实时画面预览" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Text="选择摄像头后会临时显示此机位；关闭后自动恢复主页全部机位。"
                           Style="{StaticResource SettingsCardDescription}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="StartCameraPreviewButton" Content="开始预览"
                        Style="{StaticResource SecondaryButton}" Click="StartCameraPreview_OnClick" />
                <Button x:Name="StopCameraPreviewButton" Content="停止" Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="StopCameraPreview_OnClick"
                        IsEnabled="False" />
              </StackPanel>
            </Grid>
            <Border Height="330" Margin="0,14,0,0" CornerRadius="16" Background="#111317"
                    ClipToBounds="True">
              <Grid>
                <Image x:Name="CameraPreviewImage" Stretch="Uniform" />
                <TextBlock x:Name="CameraPreviewPlaceholder" Text="正在等待摄像头画面"
                           Foreground="#B8BDC7" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                        Padding="10,5" CornerRadius="10" Background="#B21B1D22">
                  <TextBlock x:Name="CameraPreviewStatusText" Text="选择摄像头后自动预览"
                             Foreground="White" FontSize="12" />
                </Border>
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCard}">
          <Expander x:Name="AdvancedCameraExpander" IsExpanded="False">
            <Expander.Header>
              <StackPanel>
                <TextBlock Text="高级录像与画面参数" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Text="通常保持默认即可；只有设备不兼容或画面需要校正时再展开。"
                           Style="{StaticResource SettingsCardDescription}" />
              </StackPanel>
            </Expander.Header>
            <StackPanel Margin="0,16,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="分辨率" Style="{StaticResource SettingsFieldLabel}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <TextBox x:Name="WidthInput" Width="105" Style="{StaticResource SettingsInput}" />
                  <TextBlock Text="×" Margin="10,0" VerticalAlignment="Center" />
                  <TextBox x:Name="HeightInput" Width="105" Style="{StaticResource SettingsInput}" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="帧率" Margin="0,14,0,0" Style="{StaticResource SettingsFieldLabel}" />
                <TextBox x:Name="FpsInput" Grid.Row="1" Grid.Column="1" Width="105"
                         HorizontalAlignment="Left" Margin="0,14,0,0" Style="{StaticResource SettingsInput}" />
                <CheckBox x:Name="AutoFocusCheck" Grid.Row="2" Grid.Column="1" Margin="0,15,0,0"
                          Content="自动聚焦（网络来源通常由摄像机或录像机管理）" />
              </Grid>
              <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="亮度" Style="{StaticResource SettingsFieldLabel}" />
                <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="100" />
                <TextBlock Grid.Row="1" Text="对比度" Margin="0,13,0,0" Style="{StaticResource SettingsFieldLabel}" />
                <Slider x:Name="ContrastSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Margin="0,13,0,0" />
                <TextBlock Grid.Row="2" Text="清晰度" Margin="0,13,0,0" Style="{StaticResource SettingsFieldLabel}" />
                <Slider x:Name="SharpnessSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Margin="0,13,0,0" />
                <TextBlock Grid.Row="3" Text="饱和度" Margin="0,13,0,0" Style="{StaticResource SettingsFieldLabel}" />
                <Slider x:Name="SaturationSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Margin="0,13,0,0" />
              </Grid>
            </StackPanel>
          </Expander>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Background="#F9FAFC" BorderBrush="#16000000" BorderThickness="0,1,0,0" Padding="20,14">
      <Grid>
        <TextBlock Text="取消不会修改原机位；保存后仍需在设置页执行机位测试。"
                   Foreground="#6E7279" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="取消" Width="92" Style="{StaticResource SecondaryButton}"
                  IsCancel="True" Click="Cancel_OnClick" />
          <Button Content="保存机位" Width="112" Margin="10,0,0,0"
                  IsDefault="True" Click="Save_OnClick" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
