<Window x:Class="UnpackVision.App.FirstRunConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用电商拆包智能录像" Width="680" Height="650"
        MinWidth="620" MinHeight="580" Background="#F4F6FA"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <StackPanel Orientation="Horizontal">
        <Image Source="Assets/EcommerceUnpackRecorder-Logo.png" Width="62" Height="62" Stretch="Uniform" />
        <StackPanel Margin="14,4,0,0">
          <TextBlock Text="电商拆包智能录像" FontSize="27" FontWeight="SemiBold" />
          <TextBlock Text="首次使用前，请了解本地数据、相机和更新行为" Foreground="#6E6E73" Margin="0,5,0,0" />
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="20" Padding="22" Margin="0,22,0,18">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="隐私摘要" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="24"
                     Text="• 单号、录像、备注和 Excel 默认只保存在你的电脑。&#x0a;• 2.2.0 不统计日活，不生成安装 ID，不上传业务数据。&#x0a;• 自动更新只访问 GitHub，可以在设置中关闭。&#x0a;• 手机协同只连接你扫码配对的局域网电脑。&#x0a;• 面单和录像可能包含个人信息，请依法使用并控制保存期限。" />
          <Border Background="#EDF6FF" CornerRadius="14" Padding="15" Margin="0,18,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="#245A8D"
                       Text="相机权限会在进入扫码或摄像功能时再申请；麦克风默认关闭，当前版本不申请麦克风权限。" />
          </Border>
          <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <Button Content="查看用户协议" Style="{StaticResource SecondaryButton}"
                    Click="OpenTerms_OnClick" />
            <Button Content="查看隐私政策" Style="{StaticResource SecondaryButton}"
                    Margin="10,0,0,0" Click="OpenPrivacy_OnClick" />
          </StackPanel>
          <CheckBox x:Name="AcceptCheck" Margin="0,22,0,0"
                    Content="我已阅读并同意《用户协议》和《隐私政策》"
                    Checked="AcceptCheck_OnChanged" Unchecked="AcceptCheck_OnChanged" />
          <TextBlock Margin="0,10,0,0" Foreground="#7D8494" TextWrapping="Wrap"
                     Text="匿名使用统计未启用。今后即使增加，也会独立询问且默认关闭。" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2">
      <Button Content="不同意并退出" Width="140" HorizontalAlignment="Left"
              Style="{StaticResource SecondaryButton}" Click="Decline_OnClick" />
      <Button x:Name="AcceptButton" Content="同意并继续" Width="150" HorizontalAlignment="Right"
              IsEnabled="False" IsDefault="True" Click="Accept_OnClick" />
    </Grid>
  </Grid>
</Window>
